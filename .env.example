# Environment Variables for Development

# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-3.5-turbo

# Azure AI Configuration
# Format: ENDPOINT|KEY
AZURE_AI_ENDPOINT=https://your-endpoint.openai.azure.com/
AZURE_AI_KEY=your-api-key-here
AZURE_AI_MODEL=your-deployment-name

# Note: These are for development/testing only.
# In the extension, users will configure these in the Settings page.
# The extension stores API keys securely in chrome.storage.local.
